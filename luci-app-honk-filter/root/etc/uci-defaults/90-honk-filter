#!/bin/sh
# First-install defaults. Safe to run repeatedly from postinst too.

[ -n "${IPKG_INSTROOT}" ] && exit 0

# Seed config if a previous install left none.
if ! uci -q get honk-filter.main >/dev/null 2>&1; then
	uci -q set honk-filter.main=filter
	uci -q set honk-filter.main.enabled=0
	uci -q set honk-filter.dns=dns
	uci -q set honk-filter.dns.default_upstream='https://223.5.5.5/dns-query?tls_server_name=dns.alidns.com'
	uci -q set honk-filter.dns.remote_upstream='https://8.8.8.8/dns-query?tls_server_name=dns.google'
	uci -q set honk-filter.dns.bootstrap='1.1.1.1:53'
	uci -q set honk-filter.dns.fallback=remote
	uci -q set honk-filter.dns.cache=1
	uci -q set honk-filter.dns.ipv6=1
	s=$(uci -q add honk-filter dns_server)
	uci -q set "honk-filter.$s.address=https://223.5.5.5/dns-query?tls_server_name=dns.alidns.com"
	uci -q set "honk-filter.$s.group=default"
	uci -q set "honk-filter.$s.outbound=direct"
	uci -q set "honk-filter.$s.enabled=1"
	s=$(uci -q add honk-filter dns_server)
	uci -q set "honk-filter.$s.address=https://8.8.8.8/dns-query?tls_server_name=dns.google"
	uci -q set "honk-filter.$s.group=remote"
	uci -q set "honk-filter.$s.outbound=proxy"
	uci -q set "honk-filter.$s.enabled=1"
	uci -q commit honk-filter
fi

mkdir -p /etc/honk/filter/sources 2>/dev/null
chmod 0700 /etc/honk/filter /etc/honk/filter/sources 2>/dev/null
: > /tmp/honk-filter.log 2>/dev/null

exit 0
